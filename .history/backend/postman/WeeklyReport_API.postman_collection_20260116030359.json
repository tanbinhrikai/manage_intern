              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"internId\": 1,\n    \"weekStartDate\": \"2026-01-06\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/weekly-reports",
              "host": ["{{base_url}}"],
              "path": ["weekly-reports"]
            },
            "description": "Test case: Tạo report trùng với intern_id và week_start_date đã tồn tại. Expected: Error 400 - WEEKLY_REPORT_DUPLICATE"
          },
          "response": []
