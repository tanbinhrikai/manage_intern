              ]
            },
            "description": "Lấy danh sách intern với pagination.\n- Mentor: chỉ thấy intern được assign\n- Admin: thấy tất cả intern"
          },
          "response": []
        }
      ]
    },
    {
      "name": "4. Test Cases",
      "item": [
        {
          "name": "Test - Duplicate Report (Should Fail)",
          "request": {
